{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SupportAutomationCloudFormationStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:CreateStack",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:DescribeStacks",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListStackResources",
        "cloudformation:UpdateStack",
        "cloudformation:UpdateTerminationProtection",
        "cloudformation:ValidateTemplate"
      ],
      "Resource": "arn:aws:cloudformation:*:*:stack/solvelang-api-access-production-support-automation/*"
    },
    {
      "Sid": "SupportAutomationEventBridgeRules",
      "Effect": "Allow",
      "Action": [
        "events:DeleteRule",
        "events:DescribeRule",
        "events:DisableRule",
        "events:EnableRule",
        "events:ListTagsForResource",
        "events:ListTargetsByRule",
        "events:PutRule",
        "events:PutTargets",
        "events:RemoveTargets",
        "events:TagResource",
        "events:UntagResource"
      ],
      "Resource": "arn:aws:events:*:*:rule/solvelang-api-access-production-support-automation-*"
    },
    {
      "Sid": "SupportAutomationCloudWatchAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DeleteAlarms",
        "cloudwatch:PutMetricAlarm"
      ],
      "Resource": "arn:aws:cloudwatch:*:*:alarm:solvelang-api-access-production-support-automation-*"
    },
    {
      "Sid": "SupportAutomationLogMetricFilters",
      "Effect": "Allow",
      "Action": [
        "logs:DeleteMetricFilter",
        "logs:PutMetricFilter"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/solvelang-api-access-production-support-automation-*"
    }
  ]
}
