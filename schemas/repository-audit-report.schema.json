{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.solve-lang.com/schemas/repository-audit-report.schema.json",
  "title": "SolveLang Repository Audit Report",
  "description": "Deterministic, read-only Repository Audit v0 report contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "generatedAt", "mode", "engine", "source", "limits", "execution", "summary", "inventory", "detections", "findings", "redaction", "integrity"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "reportId": {"type": "string", "pattern": "^ra_[a-z0-9]{16,64}$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "mode": {"const": "analyze-only"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "rulesetVersion", "deterministic"],
      "properties": {
        "name": {"const": "SolveLang Repository Audit"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "rulesetVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "deterministic": {"const": true}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "displayName", "defaultBranch", "revision", "fingerprint"],
      "properties": {
        "kind": {"enum": ["github", "archive"]},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 200},
        "repositoryUrl": {"type": "string", "format": "uri", "maxLength": 2048},
        "defaultBranch": {"type": "string", "minLength": 1, "maxLength": 255},
        "revision": {"type": "string", "minLength": 7, "maxLength": 128},
        "fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "private": {"type": "boolean", "default": false}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFiles", "maxTotalBytes", "maxFileBytes", "maxArchiveEntries", "maxDepth", "maxFindings", "timeoutMs"],
      "properties": {
        "maxFiles": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maxTotalBytes": {"type": "integer", "minimum": 1, "maximum": 10737418240},
        "maxFileBytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "maxArchiveEntries": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maxDepth": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxFindings": {"type": "integer", "minimum": 1, "maximum": 100000},
        "timeoutMs": {"type": "integer", "minimum": 1000, "maximum": 3600000}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "finishedAt", "status", "truncated", "networkAccess", "writeAccess"],
      "properties": {
        "startedAt": {"type": "string", "format": "date-time"},
        "finishedAt": {"type": "string", "format": "date-time"},
        "status": {"enum": ["complete", "partial", "failed"]},
        "truncated": {"type": "boolean"},
        "truncationReasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["file-count", "total-bytes", "file-size", "archive-entries", "depth", "finding-count", "timeout"]}},
        "networkAccess": {"const": false},
        "writeAccess": {"const": false},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/scanError"}}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesScanned", "bytesScanned", "directoriesSeen", "findingsBySeverity", "actionsByType"],
      "properties": {
        "filesScanned": {"type": "integer", "minimum": 0},
        "filesSkipped": {"type": "integer", "minimum": 0},
        "bytesScanned": {"type": "integer", "minimum": 0},
        "directoriesSeen": {"type": "integer", "minimum": 0},
        "findingsBySeverity": {"$ref": "#/$defs/severityCounts"},
        "actionsByType": {"$ref": "#/$defs/actionCounts"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "frameworks", "packageManagers", "deploymentTargets", "fileClasses", "largeFiles"],
      "properties": {
        "languages": {"type": "array", "items": {"$ref": "#/$defs/detection"}},
        "frameworks": {"type": "array", "items": {"$ref": "#/$defs/detection"}},
        "packageManagers": {"type": "array", "items": {"$ref": "#/$defs/detection"}},
        "deploymentTargets": {"type": "array", "items": {"$ref": "#/$defs/detection"}},
        "fileClasses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "count"],
            "properties": {
              "class": {"enum": ["source", "test", "documentation", "configuration", "generated", "vendor", "asset", "archive", "backup", "unknown"]},
              "count": {"type": "integer", "minimum": 0}
            }
          }
        },
        "largeFiles": {"type": "array", "items": {"$ref": "#/$defs/fileEvidence"}}
      }
    },
    "detections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duplicates", "backupCandidates", "generatedCandidates", "secretExposureWarnings"],
      "properties": {
        "duplicates": {"type": "array", "items": {"$ref": "#/$defs/duplicateGroup"}},
        "backupCandidates": {"type": "array", "items": {"$ref": "#/$defs/fileEvidence"}},
        "generatedCandidates": {"type": "array", "items": {"$ref": "#/$defs/fileEvidence"}},
        "secretExposureWarnings": {"type": "array", "items": {"$ref": "#/$defs/redactedSecretWarning"}}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyVersion", "secretValuesIncluded", "pathNormalization", "contentExcerptPolicy"],
      "properties": {
        "policyVersion": {"const": "1.0.0"},
        "secretValuesIncluded": {"const": false},
        "pathNormalization": {"enum": ["repository-relative-posix"]},
        "contentExcerptPolicy": {"enum": ["none", "redacted-lines-only"]},
        "redactedMatchCount": {"type": "integer", "minimum": 0}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalJsonSha256", "findingOrder", "stableIds"],
      "properties": {
        "canonicalJsonSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "findingOrder": {"const": "severity-desc-rule-id-path-line"},
        "stableIds": {"const": true}
      }
    }
  },
  "$defs": {
    "severityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low", "info"],
      "properties": {
        "critical": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0}
      }
    },
    "actionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keep", "review", "move", "merge", "rewrite", "delete-candidate"],
      "properties": {
        "keep": {"type": "integer", "minimum": 0},
        "review": {"type": "integer", "minimum": 0},
        "move": {"type": "integer", "minimum": 0},
        "merge": {"type": "integer", "minimum": 0},
        "rewrite": {"type": "integer", "minimum": 0},
        "delete-candidate": {"type": "integer", "minimum": 0}
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score", "basis"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "confidence", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "maxLength": 100},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileEvidence"}}
      }
    },
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "kind": {"enum": ["file", "directory", "manifest", "config", "import", "route", "build-reference", "generated-marker", "size", "age", "hash", "name-pattern", "public-exposure", "test", "documentation", "ownership", "release"]},
        "lineStart": {"type": "integer", "minimum": 1},
        "lineEnd": {"type": "integer", "minimum": 1},
        "byteSize": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "excerpt": {"type": "string", "maxLength": 500},
        "note": {"type": "string", "maxLength": 1000}
      }
    },
    "duplicateGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupId", "matchType", "confidence", "members"],
      "properties": {
        "groupId": {"type": "string", "pattern": "^dup_[a-z0-9]{12,64}$"},
        "matchType": {"enum": ["exact-content", "normalized-content", "filename-pattern"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "members": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/fileEvidence"}}
      }
    },
    "redactedSecretWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warningId", "path", "patternClass", "exposure", "redacted", "fingerprint"],
      "properties": {
        "warningId": {"type": "string", "pattern": "^sec_[a-z0-9]{12,64}$"},
        "path": {"$ref": "#/$defs/repoPath"},
        "lineStart": {"type": "integer", "minimum": 1},
        "lineEnd": {"type": "integer", "minimum": 1},
        "patternClass": {"enum": ["api-key", "token", "password", "private-key", "connection-string", "credential-file", "unknown-secret"]},
        "exposure": {"enum": ["tracked", "public-path", "generated-output", "archive", "unknown"]},
        "redacted": {"const": true},
        "fingerprint": {"type": "string", "pattern": "^hmac-sha256:[a-f0-9]{64}$"},
        "remediation": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ruleId", "category", "severity", "title", "status", "recommendation", "confidence", "impact", "evidence", "destructive", "approvalRequired", "validation", "rollback"],
      "properties": {
        "id": {"type": "string", "pattern": "^raf_[a-z0-9]{16,64}$"},
        "ruleId": {"type": "string", "pattern": "^RA[0-9]{3}$"},
        "category": {"enum": ["inventory", "architecture", "duplication", "generated-files", "backup-files", "large-files", "dead-code", "dependencies", "imports", "routes", "configuration", "build", "secrets", "tests", "documentation", "ownership", "release-readiness", "naming", "organization"]},
        "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "status": {"enum": ["open", "accepted", "suppressed"]},
        "recommendation": {"enum": ["keep", "review", "move", "merge", "rewrite", "delete-candidate"]},
        "explanation": {"type": "string", "maxLength": 4000},
        "confidence": {"$ref": "#/$defs/confidence"},
        "impact": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileEvidence"}},
        "destructive": {"type": "boolean"},
        "approvalRequired": {"type": "boolean"},
        "validation": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "rollback": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}}
      },
      "allOf": [{
        "if": {"properties": {"recommendation": {"enum": ["move", "merge", "rewrite", "delete-candidate"]}}},
        "then": {"properties": {"destructive": {"const": true}, "approvalRequired": {"const": true}}, "required": ["destructive", "approvalRequired"]}
      }]
    },
    "scanError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "recoverable"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z0-9_]{3,64}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000},
        "path": {"$ref": "#/$defs/repoPath"},
        "recoverable": {"type": "boolean"}
      }
    },
    "repoPath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}
  }
}
