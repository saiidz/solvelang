let name = "Saiid"
let age = 21
let x = 10
let y = 5

fn greet(person) {
    print("Hello")
    print(person)
}

print("<h1>Hello from SolveLang</h1>")
print("Creator:")
greet(name)

print("<p>Math test:</p>")
print(x + y)
print(x - y)
print(x * y)
print(x / y)

if age >= 18 {
    print("<p>Status: Adult</p>")
} else {
    print("<p>Status: Minor</p>")
}

print("<p>Loop test:</p>")
let count = 1

while count <= 5 {
    print(count)
    let count = count + 1
}