# The public CLI help contract is byte-exact and uses LF on every platform.
/solvec/tests/fixtures/cli-help.txt text eol=lf

# The pinned WASM site artifact is byte-exact (its manifest sha256 is
# verified against the pin on every host): LF on every platform, so a
# Windows checkout cannot rewrite it to CRLF and break the hash.
/site/public/wasm/** binary
