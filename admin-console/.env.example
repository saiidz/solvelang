# Server-only. Never expose these with NEXT_PUBLIC_ prefixes.
SOLVELANG_ADMIN_API_BASE=https://example.execute-api.us-east-2.amazonaws.com
SOLVELANG_ADMIN_API_SECRET=replace-with-existing-api-admin-secret

# Generate with: npm run hash-password -- 'your-password'
# Format: <hex-salt>:<hex-scrypt-derived-key>
SOLVELANG_ADMIN_PASSWORD_SCRYPT=

# Independent high-entropy secret used only to sign admin-console sessions.
SOLVELANG_ADMIN_SESSION_SECRET=

# Exact origin expected for browser mutations, for example https://admin.solve-lang.com
SOLVELANG_ADMIN_CONSOLE_ORIGIN=http://localhost:3000
