{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": false,
    "outDir": ".studio-test-dist",
    "rootDir": ".",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "app/studio/core/**/*.ts",
    "app/check/core/**/*.ts",
    "app/repository-audit/core/**/*.ts",
    "app/server-audit/core/**/*.ts",
    "app/account/core/**/*.ts",
    "app/solve-graph/core/**/*.ts",
    "app/run/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out"]
}