{
  "name": "@solvelang/mcp-server",
  "version": "0.3.0",
  "description": "Local-first and remote-ready, read-only MCP server for deterministic SolveLang and n8n workflow validation",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "SolveLang",
  "homepage": "https://solve-lang.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/saiidz/solvelang.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/saiidz/solvelang/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solvelang",
    "n8n",
    "workflow",
    "validation"
  ],
  "bin": {
    "solvelang-mcp": "dist/src/index.js",
    "solvelang-mcp-remote": "dist/src/remote-cli.js"
  },
  "files": [
    "dist/src/context-compaction-tools.d.ts",
    "dist/src/context-compaction-tools.js",
    "dist/src/context-compaction.d.ts",
    "dist/src/context-compaction.js",
    "dist/src/context-handoff.d.ts",
    "dist/src/context-handoff.js",
    "dist/src/context-pack.d.ts",
    "dist/src/context-pack.js",
    "dist/src/context-selection.d.ts",
    "dist/src/context-selection.js",
    "dist/src/context-tools.d.ts",
    "dist/src/context-tools.js",
    "dist/src/context-workspace.d.ts",
    "dist/src/context-workspace.js",
    "dist/src/index.d.ts",
    "dist/src/index.js",
    "dist/src/n8n.d.ts",
    "dist/src/n8n.js",
    "dist/src/remote-cli.d.ts",
    "dist/src/remote-cli.js",
    "dist/src/remote.d.ts",
    "dist/src/remote.js",
    "dist/src/solve-graph-affected-validations.d.ts",
    "dist/src/solve-graph-affected-validations.js",
    "dist/src/solve-graph-alternative-paths.d.ts",
    "dist/src/solve-graph-alternative-paths.js",
    "dist/src/solve-graph-cycles.d.ts",
    "dist/src/solve-graph-cycles.js",
    "dist/src/solve-graph-entrypoints.d.ts",
    "dist/src/solve-graph-entrypoints.js",
    "dist/src/solve-graph-hotspots.d.ts",
    "dist/src/solve-graph-hotspots.js",
    "dist/src/solve-graph-impact-explanation.d.ts",
    "dist/src/solve-graph-impact-explanation.js",
    "dist/src/solve-graph-ranked-search.d.ts",
    "dist/src/solve-graph-ranked-search.js",
    "dist/src/solve-graph-security-summary.d.ts",
    "dist/src/solve-graph-security-summary.js",
    "dist/src/solve-graph-shortest-path-explanation.d.ts",
    "dist/src/solve-graph-shortest-path-explanation.js",
    "dist/src/solve-graph-shortest-path.d.ts",
    "dist/src/solve-graph-shortest-path.js",
    "dist/src/solve-graph-unreachable-candidates.d.ts",
    "dist/src/solve-graph-unreachable-candidates.js",
    "dist/src/solve-graph.d.ts",
    "dist/src/solve-graph.js",
    "dist/src/workspace.d.ts",
    "dist/src/workspace.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "eval:context": "npm run build && node scripts/run-context-evals.mjs",
    "eval:context:repository": "npm run build && node --test scripts/context-repository-eval.test.mjs && node scripts/run-context-repository-evals.mjs",
    "eval:context:independent": "npm run build && node --test scripts/context-independent-eval.test.mjs && node scripts/run-context-independent-evals.mjs",
    "eval:context:holdout:select": "npm run build && node scripts/context-heldout-eval.mjs select",
    "eval:context:holdout:score": "npm run build && node scripts/context-heldout-eval.mjs score",
    "test:context-holdout": "npm run build && node --test scripts/context-heldout-eval.test.mjs",
    "eval:context:agent-records": "npm run build && node scripts/summarize-context-agent-evals.mjs",
    "test:context-agent-eval-cli": "npm run build && node --test scripts/context-agent-eval-cli.test.mjs",
    "test:packed": "node scripts/smoke-packed.mjs",
    "test:plugin-roundtrip": "node scripts/smoke-plugin-roundtrip.mjs",
    "test:release-candidate": "node scripts/validate-release-candidate.mjs",
    "test:release-finalization": "npm run build && node scripts/qualify-release-finalization.mjs",
    "test:distribution-finalization": "node scripts/qualify-distribution-finalization.mjs",
    "prepack": "npm run build && node scripts/prepare-pack.mjs",
    "start": "node dist/src/index.js",
    "start:remote": "node dist/src/remote-cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
