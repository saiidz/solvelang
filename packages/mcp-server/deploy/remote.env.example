# SolveLang remote MCP — production environment (EXAMPLE).
#
# Copy this file to remote.env IN THE SAME DIRECTORY on the deployment
# host and replace the token there. remote.env must never be committed,
# pasted into chat, or stored anywhere except the host's secret store /
# this file on the host.
#
# Generate the token ON THE HOST, e.g.:  openssl rand -hex 32
# (64 hex characters — inside the server's 32-1024 byte token bound.)
SOLVELANG_REMOTE_BEARER_TOKEN=REPLACE_WITH_A_TOKEN_GENERATED_ON_THE_HOST

# Optional: a second, independent bearer token for directory health
# checkers (e.g. Glama). MCP_REMOTE_TEST_TOKEN authenticates the same
# read-only surface as the production token above and can be revoked on
# its own (remove the line and recreate the container) without rotating
# the production token. Leave unset to disable. Generate the value ON
# THE HOST the same way (openssl rand -hex 32); never commit it.
# MCP_REMOTE_TEST_TOKEN=REPLACE_WITH_A_TOKEN_GENERATED_ON_THE_HOST

# Bearer auth is the production mode. The anonymous "noauth" mode exists
# only for a separately reviewed public plugin deployment.
SOLVELANG_REMOTE_AUTH_MODE=bearer

# Built-in fixed-window rate limiter (per source address, enforced
# before authentication and MCP parsing). 0 disables it — do not
# disable in production; edge rate limiting is still required as well.
SOLVELANG_REMOTE_RATE_LIMIT=60
SOLVELANG_REMOTE_RATE_WINDOW_MS=60000

# Optional: only for an OpenAI Apps Directory submission, set to the
# exact token from the OpenAI submission portal.
# SOLVELANG_OPENAI_APPS_CHALLENGE_TOKEN=

# Optional: Team Context Index (remote MCP tier). When neither setting is
# present, every /teams route fails closed (503) and /mcp keeps its exact
# single-user behavior. The file store keeps team records (emails, roles,
# token SHA-256 hashes, and each team's shared context index) as JSON at
# the given path — plaintext team tokens are never stored. The path must
# be writable by the container (mount a volume there); see
# docs/integrations/team-context-index.md.
# SOLVELANG_REMOTE_TEAM_STORE_FILE=/data/teams.json
# In-memory alternative for tests/dev only (records die with the process):
# SOLVELANG_REMOTE_TEAMS=memory

# Optional: Team Context Index billing (per-seat, $8/seat/month). The
# billing token authorizes ONLY the read-only seat-count routes
# (GET /billing/teams, GET /billing/teams/:id) used by the API access
# service; it does not authenticate /mcp or /teams. Generate it ON THE
# HOST the same way (openssl rand -hex 32); never commit it. Leave
# unset to keep the billing routes dark (503).
# MCP_REMOTE_BILLING_TOKEN=<redacted>
#
# Optional: seat-count sync. When BOTH are set, membership changes
# (invite accepted, member revoked) POST the team's new active-seat
# count to the API access service, which moves the team's Stripe
# subscription quantity to match. The secret is shared with the API
# service only. Sync is best-effort: a failure is logged and never
# fails the membership change. Leave unset to disable.
# SOLVELANG_TEAM_BILLING_SYNC_URL=https://api.solve-lang.com/team-context/seat-sync
# SOLVELANG_TEAM_BILLING_SYNC_SECRET=<redacted>
