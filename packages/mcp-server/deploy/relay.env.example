# SolveLang hosted relay — production environment (EXAMPLE).
#
# Copy this file to relay.env IN THE SAME DIRECTORY on the deployment
# host. relay.env holds no secrets: bearer tokens live only as SHA-256
# hashes in relay.config.json (see relay.config.example.json), and the
# token values themselves are generated on the host and handed to the
# owner through the Secure Vault — never committed, never pasted into
# chat.

# Built-in fixed-window rate limiter (per source address — the first
# X-Forwarded-For hop when SOLVELANG_RELAY_TRUST_PROXY=1 — enforced
# before authentication). 0 disables it — do not disable in production;
# edge rate limiting is still required as well.
SOLVELANG_RELAY_RATE_LIMIT=300
SOLVELANG_RELAY_RATE_WINDOW_MS=60000

# The relay only ever sits behind the host's TLS reverse proxy, which
# sets X-Forwarded-For; trust it for per-client rate limiting.
SOLVELANG_RELAY_TRUST_PROXY=1
